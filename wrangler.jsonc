{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "google-one-price",
  "compatibility_date": "2026-11-27",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash"
  },
  "routes": [
    {
      "pattern": "googleone.laifuyou.com",
      "custom_domain": true
    }
  ]
}
