---
import { getMetadata } from "../lib/data";
import { formatShanghaiTime } from "../lib/format";

const nav = [
  { href: "/", label: "方案推荐" },
  { href: "/countries", label: "国家/地区" },
  { href: "/matrix", label: "全量比价" },
  { href: "/guide", label: "避坑指南" },
  { href: "/data", label: "数据与更新" },
];
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const active = (href: string) =>
  href === path ||
  (href !== "/" && path.startsWith(`${href}/`)) ||
  (href === "/matrix" && path.startsWith("/tiers/"));
const { pricesObservedAt, fxDate } = getMetadata();
---

<header class="site-header">
  <div class="wrap header-inner">
    <a href="/" class="wordmark" aria-label="G1 价目首页"
      ><i aria-hidden="true"></i><span class="mono">G1</span> 价目</a
    >
    <nav class="desktop-nav" aria-label="主导航">
      {nav.map(({ href, label }) => (
        <a href={href} aria-current={active(href) ? "page" : undefined}>
          {label}
        </a>
      ))}
    </nav>
    <a href="/data" class="header-meta mono small">
      价格{" "}
      <time
        id="price-observation"
        datetime={`${pricesObservedAt}+08:00`}
        title={formatShanghaiTime(pricesObservedAt)}
        >{pricesObservedAt.slice(5, 10)}</time
      >
      {" · 汇率 "}<time datetime={fxDate}>{fxDate.slice(5)}</time>
    </a>
    <details class="mobile-nav">
      <summary aria-label="主导航菜单">
        <svg
          aria-hidden="true"
          viewBox="0 0 16 16"
          width="16"
          height="16"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
        >
          <path d="M2.5 4h11m-11 4h11m-11 4h11"></path>
        </svg>
      </summary>
      <nav aria-label="主导航">
        {nav.map(({ href, label }) => (
          <a href={href} aria-current={active(href) ? "page" : undefined}>
            {label}
          </a>
        ))}
      </nav>
    </details>
  </div>
</header>
<div class="stale-banner" id="stale-prices" hidden>
  <div class="wrap">
    价格数据已超过 30 天未更新，仅供参考。
    <a href="/data#freshness">查看观测时间</a>
  </div>
</div>
<script>
import { priceFreshness } from "../lib/data/freshness";

const time = document.querySelector<HTMLTimeElement>("#price-observation");
const banner = document.getElementById("stale-prices");
if (time && banner) {
  const refresh = () => {
    const { days, state } = priceFreshness(time.dateTime);
    time.textContent =
      days === 0 ? "今天" : days === 1 ? "昨天" : `${days} 天前`;
    banner.hidden = state !== "stale";
  };
  refresh();
  window.addEventListener("pageshow", refresh);
}
</script>
<style>
.site-header {
  position: sticky;
  top: 0;
  z-index: 20;
  background: var(--bg-canvas);
  border-bottom: 1px solid var(--border-default);
}
.header-inner {
  display: flex;
  align-items: center;
  height: calc(var(--header-height) - 1px);
  gap: 24px;
}
.wordmark {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  font-size: 16px;
  line-height: 24px;
  font-weight: 600;
  white-space: nowrap;
  text-decoration: none;
}
.wordmark i {
  width: 6px;
  height: 6px;
  background: var(--warn);
  margin-right: 4px;
}
.desktop-nav {
  display: flex;
  align-self: stretch;
  gap: 16px;
}
nav a {
  text-decoration: none;
  color: var(--text-secondary);
  white-space: nowrap;
}
nav a:where(:hover, [aria-current]) {
  color: var(--text-primary);
}
.desktop-nav a {
  display: flex;
  align-items: center;
  border-bottom: 2px solid transparent;
}
.desktop-nav a[aria-current] {
  border-color: var(--text-primary);
  font-weight: 600;
}
.header-meta {
  margin-inline-start: auto;
  padding: 4px 7px;
  border: 1px solid var(--border-default);
  border-radius: 4px;
  white-space: nowrap;
  text-decoration: none;
  color: var(--muted-ink);
}
.header-meta:hover {
  color: var(--text-primary);
}
.stale-banner {
  background: var(--warn-bg);
  color: var(--warn);
  border-bottom: 1px solid var(--warn);
  padding-block: 8px;
}
.mobile-nav {
  display: none;
}
@media (max-width: 767px) {
  .site-header {
    position: relative;
  }
  .header-inner {
    gap: 10px;
  }
  .desktop-nav {
    display: none;
  }
  .mobile-nav {
    display: block;
  }
  .mobile-nav summary {
    display: grid;
    place-items: center;
    list-style: none;
    width: 32px;
    height: 32px;
    border: 1px solid var(--border-default);
    border-radius: 4px;
  }
  .mobile-nav summary::-webkit-details-marker {
    display: none;
  }
  .mobile-nav nav {
    position: absolute;
    inset: 100% 0 auto;
    display: grid;
    padding: 4px 12px;
    background: var(--bg-surface);
    box-shadow: 0 3px 6px rgb(0 0 0 / 0.1);
    border-bottom: 1px solid var(--border-default);
  }
  .mobile-nav nav a {
    padding: 10px 8px;
  }
  .mobile-nav nav a[aria-current] {
    font-weight: 600;
    border-left: 2px solid var(--text-primary);
  }
}
</style>
