---
interface Props {
  id: string;
  label: string;
  placeholder: string;
  target?: string;
  matrix?: boolean;
}
const { id, label, placeholder, target, matrix } = Astro.props;
---

<label class="search">
  <svg
    aria-hidden="true"
    width="14"
    height="14"
    viewBox="0 0 16 16"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
  >
    <circle cx="6.75" cy="6.75" r="4.25"></circle>
    <path d="m10 10 3.5 3.5"></path>
  </svg>
  <input
    type="search"
    id={id}
    aria-label={label}
    placeholder={placeholder}
    data-filter-target={target}
    data-matrix-filter={matrix ? "q" : undefined}
    autocomplete="off"
  >
</label>
