---
import {
  hasHistoricalPriceAnomaly,
  isGlobalTierLowest,
  type Quote,
  quoteLine,
  quoteTier,
  tierGroups,
} from "../lib/data";
import { formatCny, formatLocal, formatSkuDescription } from "../lib/format";
import { priceDisplay } from "../lib/price-display";

interface Props {
  quotes: Quote[];
}
const { quotes } = Astro.props;
const histories = quotes.filter(({ status }) => status === "historical").length;
const entries = quotes.map((quote) => ({
  quote,
  display: priceDisplay(quote),
}));
const groups = tierGroups.map((group) => ({
  ...group,
  rows: entries
    .filter(({ quote }) => quoteLine(quote) === group.line)
    .sort((a, b) => a.display.prices.year - b.display.prices.year),
}));
---

<section
  id="country-skus"
  data-filter-line="all"
  data-show-history="no"
  aria-label="SKU 报价"
>
  <div class="sku-controls">
    <fieldset class="pills" aria-label="筛选产品线">
      {[{ line: "all", shortName: "全部" }, ...groups].map(
        ({ line, shortName }, index) => (
          <label class="control">
            <input
              class="sr-only"
              type="radio"
              name="sku-line"
              data-sku-line
              value={line}
              checked={index === 0}
            />
            {shortName}
          </label>
        ),
      )}
    </fieldset>
    <label class="control">
      <input type="checkbox" data-sku-history disabled={histories === 0}>
      含历史快照 <span class="mono">(+{histories})</span>
    </label>
  </div>
  <div class="panel">
    <table class="data-table sku-table">
      <thead>
        <tr>
          <th scope="col">档位说明 / SKU</th>
          <th scope="col" class="num">首期（折月）</th>
          <th scope="col" class="num">续费（折月）</th>
          <th scope="col" class="num">首年月均</th>
          <th scope="col">状态</th>
        </tr>
      </thead>
      {groups.map(({ name, line, rows }) => (
        <tbody data-sku-group={line}>
          <tr class="table-group">
            <th scope="rowgroup" colspan="5">
              {name}
            </th>
          </tr>
          {rows.map(({ quote, display }) => {
            const { intro, currency, renewal } = quote;
            const unit = display.annual ? "/年" : "";
            const isHistorical = quote.status === "historical";
            const lowest = isGlobalTierLowest(
              quote,
              "year",
              display.prices.year,
            );
            const tier = quoteTier(quote);
            return (
              <tr data-sku-row={quote.status} title={quote.source}>
                <th scope="row" class="sku-name">
                  <p>{formatSkuDescription(quote.description)}</p>
                  <button
                    class="copy-sku mono small"
                    type="button"
                    title="复制 SKU"
                    data-copy={quote.skuId}
                  >
                    {quote.skuId}
                    <span role="status" data-copy-status></span>
                  </button>
                </th>
                <td class="num sku-amount">
                  <span class="mobile-price-label">首期（折月）</span>
                  <span>
                    {display.trial
                      ? display.duration
                      : intro
                        ? `${display.introCny}/月`
                        : "·"}
                  </span>
                  {intro && !display.trial && (
                    <span class="original muted small">
                      {formatLocal(intro.local, currency)}
                      {unit}
                    </span>
                  )}
                  {!display.trial && display.duration && (
                    <span class="muted small">{display.duration}</span>
                  )}
                </td>
                <td class="num sku-amount">
                  <span class="mobile-price-label">续费（折月）</span>
                  <span>{display.renewCny}/月</span>
                  <span class="original muted small">
                    {formatLocal(renewal.local, currency)}
                    {unit}
                  </span>
                </td>
                <td class="num sku-amount">
                  <span class="mobile-price-label">首年月均</span>
                  <span>{formatCny(display.prices.year)}/月</span>
                  {display.badge && !display.trial && (
                    <span class={`badge small ${display.badge.level}`}>
                      {display.badge.label}
                    </span>
                  )}
                </td>
                <td class="sku-status small">
                  {isHistorical ? (
                    <span class="sku-status-badges">
                      <span class="badge historical-badge">历史快照</span>
                      {hasHistoricalPriceAnomaly(quote) && (
                        <span class="badge warn">源数据异常</span>
                      )}
                    </span>
                  ) : lowest && tier ? (
                    <a class="badge best" href={`/tiers/${tier}`}>
                      全球最低
                    </a>
                  ) : (
                    <span class="muted">·</span>
                  )}
                </td>
              </tr>
            );
          })}
        </tbody>
      ))}
    </table>
    <p class="empty-message" data-sku-empty hidden>
      此产品线没有符合筛选条件的报价。
    </p>
  </div>
</section>
<style>
.sku-controls {
  display: flex;
  flex-wrap: wrap;
  gap: 6px 12px;
  margin-bottom: 10px;
}
.sku-controls .control:has(:focus-visible) {
  outline: 2px solid var(--text-primary);
  outline-offset: 2px;
}
.sku-controls label:has(:disabled) {
  cursor: default;
  opacity: 0.7;
}
[data-sku-row="historical"] {
  color: var(--muted-ink);
}
#country-skus[data-filter-line="ultra"] tbody:not([data-sku-group="ultra"]),
#country-skus[data-filter-line="pro"] tbody:not([data-sku-group="pro"]),
#country-skus[data-filter-line="plus"] tbody:not([data-sku-group="plus"]),
#country-skus[data-filter-line="storage"] tbody:not([data-sku-group="storage"]),
#country-skus[data-show-history="no"] tbody:not(:has([data-sku-row="active"])),
#country-skus[data-show-history="no"] [data-sku-row="historical"],
#country-skus[data-show-history="yes"] tbody:not(:has([data-sku-row])) {
  display: none;
}
.sku-table :is(th, td):not(.sku-name) {
  white-space: nowrap;
}
.sku-table tbody tr[data-sku-row]:hover {
  background: var(--bg-hover);
}
.sku-name {
  text-align: left;
  font-weight: 500;
}
.sku-amount > :is(span, small) {
  display: block;
}
.sku-status-badges {
  display: flex;
  flex-wrap: wrap;
  gap: 4px;
}
.sku-amount .badge {
  display: inline-block;
}
.historical-badge {
  background: var(--bg-subtle);
}
.sku-amount .mobile-price-label {
  display: none;
}
@media (max-width: 767px) {
  .sku-table,
  .sku-table tbody,
  .sku-table .table-group,
  .sku-table .table-group th {
    display: block;
  }
  .sku-table thead {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }
  .sku-table [data-sku-row] {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-bottom: 1px solid var(--border-default);
  }
  .sku-table [data-sku-row] > * {
    border: 0;
    padding: 4px 6px;
  }
  .sku-table .sku-name {
    grid-column: 1 / 3;
  }
  .sku-status {
    grid-column: 3;
    grid-row: 1;
    text-align: right;
  }
  .sku-amount .mobile-price-label {
    display: block;
    color: var(--text-secondary);
    font: 11px / 15px var(--font-ui);
  }
  .sku-table .sku-amount .badge {
    font-size: 10px;
  }
}
</style>
