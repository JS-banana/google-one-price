---
import { getCountries, getMetadata, getQuoteCount } from "../lib/data";
import {
  formatLocalNumber,
  formatRate,
  formatShanghaiTime,
} from "../lib/format";

const { refreshedAt, usdToCny } = getMetadata();
---

<footer>
  <div class="wrap small muted">
    <p>
      非 Google 官方网站。价格来自 iOS App Store
      监控抓取，人民币为按实时汇率折算的参考值，实际扣款以 App Store 为准。
    </p>
    <p>
      数据更新
      <time datetime={`${refreshedAt}+08:00`}
        >{formatShanghaiTime(refreshedAt)}</time
      >{" · "}汇率基准
      <span class="mono">1 USD = {formatRate(usdToCny)} CNY</span> · 共
      <span class="mono">{getCountries().length}</span> 个国家/地区、<span
        class="mono"
        >{formatLocalNumber(getQuoteCount())}</span
      >{" "}条报价
    </p>
  </div>
</footer>
<style>
footer {
  border-top: 1px solid var(--border-default);
}
footer .wrap {
  display: grid;
  gap: 4px;
  padding-block: 16px 22px;
}
</style>
