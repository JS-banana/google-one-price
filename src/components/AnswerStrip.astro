---
import {
  type Country,
  getTierRanking,
  priceViews,
  tierGroups,
  tiers,
} from "../lib/data";
import { formatCny } from "../lib/format";
import { priceDisplay } from "../lib/price-display";
import CountryLabel from "./CountryLabel.astro";

interface Props {
  countries: ReadonlyMap<string, Country>;
}
const { countries } = Astro.props;
---

<section class="answer-strip" aria-label="各产品线最低价">
  {tierGroups
    .filter(({ line }) => line !== "offers")
    .map(({ ids, shortName }) => (
      <div class="answer-cell">
        {priceViews.map((view) => {
          const lowest = ids
            .flatMap((id) =>
              getTierRanking(id, view)
                .slice(0, 1)
                .map((row) => ({ id, ...row })),
            )
            .sort((a, b) => a.price - b.price)[0];
          if (!lowest) return null;
          const { id, quote, price } = lowest;
          const country = countries.get(quote.countryCode);
          if (!country)
            throw new Error(`Unknown country: ${quote.countryCode}`);
          const display = priceDisplay(quote);
          const label = formatCny(price, view, display.trial);
          return (
            <div class="view-content" data-price-view={view}>
              <a href={`/tiers/${id}`} class="answer-link">
                <h2>{shortName}</h2>
                <div class="answer-main">
                  <CountryLabel {country} eager />
                  <span class="answer-amount mono best-text">{label}</span>
                  {display.annual && <span class="annual small">年付</span>}
                </div>
                <div class="answer-detail small muted">
                  <span>{tiers[id].shortName}</span>
                  <span class:list={["mono", "original"]}>{display.raw}</span>
                  {display.offer && (
                    <span class="mono cny-offer-when-hidden">
                      {display.introCny} → {display.renewCny}
                    </span>
                  )}
                  {display.badge && (
                    <span class={`badge ${display.badge.level}`}>
                      {display.badge.label}
                    </span>
                  )}
                </div>
              </a>
            </div>
          );
        })}
      </div>
    ))}
</section>
<style>
.answer-strip {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  padding-block: 14px;
  margin-bottom: 14px;
}
.answer-cell {
  padding: 2px 12px;
  border-right: 1px solid var(--border-default);
}
.answer-cell:first-child {
  padding-left: 0;
}
.answer-cell:last-child {
  padding-right: 0;
  border-right: 0;
}
.answer-link {
  display: grid;
  gap: 3px;
  text-decoration: none;
}
.answer-link:where(:hover) h2 {
  text-decoration: underline;
  text-underline-offset: 3px;
}
.answer-link h2 {
  font-size: 13px;
  line-height: 18px;
}
.answer-main {
  display: flex;
  align-items: center;
  column-gap: 8px;
  flex-wrap: wrap;
}
.answer-amount {
  font-size: 24px;
  line-height: 30px;
  white-space: nowrap;
}
.answer-detail {
  display: flex;
  flex-wrap: wrap;
  column-gap: 6px;
}
@media (max-width: 767px) {
  .answer-strip {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    padding-block: 8px;
    margin-bottom: 8px;
  }
  .answer-cell {
    padding: 6px 8px;
  }
  .answer-cell:nth-child(odd) {
    padding-left: 0;
  }
  .answer-cell:nth-child(even) {
    padding-right: 0;
    border-right: 0;
  }
  .answer-cell:nth-child(-n + 2) {
    border-bottom: 1px solid var(--border-default);
  }
  .answer-main {
    column-gap: 5px;
  }
  .answer-amount {
    font-size: 20px;
    line-height: 26px;
  }
}
</style>
