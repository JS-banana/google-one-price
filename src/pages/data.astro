---
import ChangeGroups from "../components/ChangeGroups.astro";
import Layout from "../components/Layout.astro";
import SearchInput from "../components/SearchInput.astro";
import {
  cnyPerLocal,
  fxProviderUrl,
  getChanges,
  getCountries,
  getExchangeRates,
  getMetadata,
  summarizeChanges,
} from "../lib/data";
import { formatRate, formatShanghaiTime } from "../lib/format";

const rates = getExchangeRates();
const countries = getCountries();
const changes = getChanges();
const summary = summarizeChanges(changes);
const countryMap = new Map(countries.map((country) => [country.code, country]));
const kinds = [...new Set(changes.map(({ kind }) => kind))];
const filters = kinds.length > 1 ? ["全部", ...kinds] : kinds;
const { usdToCny, fxProvider, fxDate, pricesObservedAt, changesCheckedAt } =
  getMetadata();
const title = "数据与更新";
const description = `查看 Google One 与 Gemini iOS 价格观测时间、${summary.count} 条变动记录和 ${rates.length} 种参考汇率，了解订阅总成本、首期价格和续费的计算口径。`;
---

<Layout {title} {description}>
  <div class="page-heading"><h1>数据与更新</h1></div>
  <nav class="data-jumps pills" aria-label="数据页目录">
    <a class="control" href="#freshness">数据时效</a>
    <a class="control" href="#calculation">计算口径</a>
    <a class="control" href="#changes">变动记录</a>
    <a class="control" href="#fx">汇率表</a>
    <a class="control" href="#terms">免责声明</a>
  </nav>
  <section aria-labelledby="freshness">
    <h2 class="section-heading" id="freshness">数据时效</h2>
    <dl class="change-summary">
      <div>
        <dt>价格观测（北京时间）</dt>
        <dd>
          <time datetime={`${pricesObservedAt}+08:00`}
            >{formatShanghaiTime(pricesObservedAt)}</time
          >
        </dd>
      </div>
      <div>
        <dt>变动检查（北京时间）</dt>
        <dd>
          <time datetime={`${changesCheckedAt}+08:00`}
            >{formatShanghaiTime(changesCheckedAt)}</time
          >
        </dd>
      </div>
      <div>
        <dt>汇率参考日期</dt>
        <dd>
          <time datetime={fxDate}>{fxDate}</time> ·
          <a href={fxProviderUrl}>{fxProvider}</a>
        </dd>
      </div>
    </dl>
  </section>
  <section class="rates-section" aria-labelledby="calculation">
    <h2 class="section-heading" id="calculation">计算口径</h2>
    <dl class="method-list">
      <div>
        <dt>报价来源与更新</dt>
        <dd>
          报价来自 iOS App Store
          商品目录监控。价格快照与汇率独立更新，各自的参考时间见上方。
        </dd>
      </div>
      <div>
        <dt>决策器总成本</dt>
        <dd>
          按所选月数累计期间实际扣款。月付按期支付，免费试用结束才开始扣款。年付每次扣一整年，即使计划用
          3 个月。
          先累计原币，再折算人民币。月均为总额除以计划月数，家庭共享可用时按人数平摊。
        </dd>
      </div>
      <div>
        <dt>人民币换算</dt>
        <dd>
          原币金额 × USD/CNY ÷ 1 USD
          兑换的原币数量。显示金额保留两位小数，排名使用舍入前的价格。
        </dd>
      </div>
      <div>
        <dt>首期月价</dt>
        <dd>
          优惠期间每月的人民币价格。无优惠时取续费原价，免费试用按 SKU
          编码显示时长。
        </dd>
      </div>
      <div>
        <dt>首年月均</dt>
        <dd>
          首年付款总额 ÷ 12。月付的付费优惠按说明里的期数计算，免费试用按 SKU
          编码扣除试用月数。年付试用结束时计入一次完整年费，年付首年折扣取折后年费。
        </dd>
      </div>
      <div>
        <dt>比较范围</dt>
        <dd>
          决策器按产品与资格比较活跃报价，用对比地区的主线常规报价计算差额。
          <a href="/matrix">全量比价</a
          >展示精选档位与免费试用，并可切换首期、首年月均和续费口径。完整报价见<a
            href="/countries"
            >地区档案</a
          >。
        </dd>
      </div>
      <div>
        <dt>续费月价</dt>
        <dd>
          优惠结束后每月折合的人民币价格。原币副价保留 App Store 的实际账期。
        </dd>
      </div>
      <div>
        <dt>活跃／历史快照</dt>
        <dd>
          活跃报价来自当前目录或监控结果，参与排名。历史快照保留当时的币种和报价，可在国家页面展开。
        </dd>
      </div>
      <div>
        <dt>USD 计价区</dt>
        <dd>
          美国以外使用 USD 标价的 App Store 地区。档位排名和矩阵可筛掉这些地区。
        </dd>
      </div>
      <div>
        <dt>续费跳涨</dt>
        <dd>
          跳涨倍数 = 续费原币价 ÷
          首期原币价。零元试用直接展示试用结束后的月均续费价。
        </dd>
      </div>
    </dl>
  </section>
  <section class="rates-section" aria-labelledby="changes">
    <h2 class="section-heading" id="changes">变动记录</h2>
    <dl class="change-summary">
      <div>
        <dt>变动</dt>
        <dd><span class="mono">{summary.count}</span> 条</dd>
      </div>
      <div>
        <dt>涉及地区</dt>
        <dd><span class="mono">{summary.countries}</span> 个</dd>
      </div>
      <div>
        <dt>免费试用／首期优惠</dt>
        <dd class="mono">{summary.trials} / {summary.offers}</dd>
      </div>
    </dl>
    {kinds.length > 1 && (
      <fieldset class="pills change-filters" aria-label="变动类型">
        {filters.map((kind, index) => (
          <label class="control">
            <input
              class="sr-only"
              type="radio"
              name="change-kind"
              data-change-kind
              value={kind}
              checked={index === 0}
            />
            {kind === "新发现地区SKU" ? "新发现地区 SKU" : kind}
          </label>
        ))}
      </fieldset>
    )}
    {filters.map((kind, index) => (
      <div data-kind-panel={kind} hidden={index !== 0}>
        <ChangeGroups
          changes={
            kind === "全部"
              ? changes
              : changes.filter((change) => change.kind === kind)
          }
          countries={countryMap}
          linkable={index === 0}
        />
      </div>
    ))}
    {filters.length === 0 && (
      <p class="empty-message">本次检查没有变动记录。</p>
    )}
  </section>
  <section class="rates-section" aria-labelledby="fx">
    <div class="section-heading rates-heading">
      <div>
        <h2 id="fx">汇率表</h2>
        <p class="secondary">
          基准
          <strong class="mono">1 USD = {formatRate(usdToCny)} CNY</strong> ·
          汇率日期 <time datetime={fxDate}>{fxDate}</time> ·
          <a href={fxProviderUrl}>{fxProvider}</a>
        </p>
      </div>
      <SearchInput
        id="rate-q"
        label="筛选币种或地区"
        placeholder="搜索币种或地区"
        target="rate-list"
      />
    </div>
    <div class="panel" id="rate-list">
      <table class="data-table rate-table">
        <thead>
          <tr>
            <th scope="col">币种</th>
            <th scope="col">中文名</th>
            <th scope="col" class="num">1 USD 兑本币</th>
            <th scope="col" class="num">1 本币折 CNY</th>
            <th scope="col">地区</th>
          </tr>
        </thead>
        <tbody>
          {rates.map(({ currency, nameZh, unitsPerUsd, date }) => {
            const locales = countries.filter(
              (country) => country.currency === currency,
            );
            const links = locales.map(({ code, nameZh }) => (
              <a href={`/countries/${code.toLowerCase()}`}>{nameZh}</a>
            ));
            const first =
              locales.find(({ code }) => code === "USA") ?? locales[0];
            return (
              <tr
                data-match={`${currency} ${nameZh} ${locales.map(({ code, nameZh, nameEn }) => `${code} ${nameZh} ${nameEn}`).join(" ")}`}
              >
                <th scope="row" class="mono rate-currency">
                  {currency}
                  <span class="rate-mobile-name">{nameZh}</span>
                </th>
                <td class="rate-name">{nameZh}</td>
                <td class="num">
                  {formatRate(unitsPerUsd)}
                  {date !== fxDate && (
                    <div class="small muted">
                      <time datetime={date}>{date}</time>
                    </div>
                  )}
                </td>
                <td class="num">{formatRate(cnyPerLocal(currency))}</td>
                <td class="rate-locales">
                  {locales.length === 0 ? (
                    <span class="muted">·</span>
                  ) : locales.length <= 4 ? (
                    links
                  ) : (
                    <>
                      <span class="rate-all-locales">{links}</span>
                      <details class="rate-more-locales">
                        <summary>
                          {first.nameZh} 等 {locales.length} 个地区
                        </summary>
                        <div>{links}</div>
                      </details>
                    </>
                  )}
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
      <p class="empty-message" data-filter-empty hidden>
        找不到符合条件的币种。
      </p>
    </div>
  </section>
  <section class="rates-section" aria-labelledby="faq">
    <h2 class="section-heading" id="faq">常见问题</h2>
    <dl class="method-list">
      <div>
        <dt>为什么同一地区有多个相近的 SKU？</dt>
        <dd>
          同一套餐可能通过多个商品编号上架。每个档位按当前口径为每个地区选一条最低活跃报价，国家详情保留各
          SKU。
        </dd>
      </div>
      <div>
        <dt>最低价能直接购买吗？</dt>
        <dd>
          订阅和优惠资格由你的 App Store
          地区、账户及商品条款决定。请在确认付款前核对实际金额、续费日期和税费。
        </dd>
      </div>
    </dl>
  </section>
  <section class="rates-section disclaimer" aria-labelledby="terms">
    <h2 class="section-heading" id="terms">免责声明</h2>
    <p>
      本站是独立的价格查询工具，与 Google 和 Apple
      无隶属、合作或授权关系。数据为监控时点的 App Store
      报价及汇率折算，仅供参考。实际可购买的档位、优惠资格、税费、汇率与扣款金额以你的
      App Store 付款确认页及付款机构为准。
    </p>
    <p id="data-license">
      数据使用：原始商品信息及商标归各权利人所有，使用须遵循各来源条款。本站的整理及人民币换算供查询参考。
      人民币折算采用 Frankfurter 提供的混合参考汇率。<a
        href="https://frankfurter.dev/license/"
        >Frankfurter 数据条款</a
      >
    </p>
  </section>
</Layout>
<style>
.data-jumps {
  margin-bottom: 14px;
}
h2[id],
#data-license {
  scroll-margin-top: calc(var(--header-height) + 8px);
}

.method-list {
  background: var(--bg-surface);
  border: 1px solid var(--border-default);
  border-radius: 4px;
}
.method-list > div {
  display: grid;
  grid-template-columns: minmax(125px, 1fr) 6fr;
  gap: 8px 16px;
  padding: 8px 12px;
}
.method-list > div + div {
  border-top: 1px solid var(--border-default);
}
.method-list dt {
  font-weight: 600;
}
.method-list dd,
.disclaimer p {
  color: var(--text-secondary);
  font-size: 14px;
  line-height: 22px;
}
.rates-section {
  margin-top: 22px;
}
.rates-heading {
  flex-wrap: wrap;
  align-items: flex-end;
  justify-content: space-between;
}
.rates-heading h2 {
  margin-bottom: 3px;
}
.rate-currency {
  text-align: left;
  white-space: nowrap;
}
.rate-mobile-name {
  display: none;
}
.rate-table th:first-child,
.rate-table td.num,
.rate-table th.num {
  white-space: nowrap;
}
.rate-table tr:hover td,
.rate-table tr:hover th[scope="row"] {
  background: var(--bg-hover);
}
.rate-locales a {
  display: inline-flex;
  align-items: center;
  min-width: 24px;
  min-height: 24px;
  margin-right: 8px;
}
.rate-more-locales {
  display: none;
}
.disclaimer p + p {
  margin-top: 6px;
}
@media (max-width: 767px) {
  .method-list > div {
    grid-template-columns: minmax(0, 1fr);
    gap: 2px;
  }
  .rate-table th,
  .rate-table td {
    padding-inline: 5px;
  }
  .rate-name,
  .rate-table :where(thead) th:where(:nth-child(2)) {
    display: none;
  }
  .rate-mobile-name {
    display: block;
    color: var(--text-secondary);
    font: 11px / 15px var(--font-ui);
  }
  .rate-all-locales {
    display: none;
  }
  .rate-more-locales {
    display: block;
  }
  .rate-more-locales summary {
    cursor: pointer;
  }
  .rate-table td,
  .rate-table th {
    font-size: 11px;
  }
}
.change-summary {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  background: var(--bg-subtle);
  border: 1px solid var(--border-default);
  border-radius: 4px;
}
.change-summary > :where(div) {
  padding: 8px 12px;
}
.change-summary > div + div {
  border-left: 1px solid var(--border-default);
}
.change-summary dt {
  color: var(--text-secondary);
}
.change-summary dd {
  font-weight: 600;
  margin-top: 2px;
}
.change-filters {
  margin-block: 12px 8px;
}
.change-summary + [data-kind-panel] {
  margin-top: 12px;
}
.change-filters .control:has(:focus-visible) {
  outline: 2px solid var(--text-primary);
  outline-offset: 2px;
}
@media (max-width: 499px) {
  .change-summary {
    grid-template-columns: 1fr;
  }
  .change-summary > div + div {
    border-left: 0;
    border-top: 1px solid var(--border-default);
  }
}
</style>
