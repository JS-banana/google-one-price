---
import Decision from "../components/Decision";
import Layout from "../components/Layout.astro";
import {
  getCountryMeta,
  getDecisionData,
  getMetadata,
  getProducts,
} from "../lib/data";
import type { Need } from "../lib/data/decision";
import { giftCardLabels, paymentMethods } from "../lib/decision-labels";

const data = getDecisionData();
const { pricesObservedAt, fxDate } = getMetadata();
const products = getProducts();
const familyHints = Object.fromEntries(
  Object.entries(products).map(([need, { familySharing }]) => [
    need,
    [
      familySharing.maxAdditionalMembers &&
        `最多可与 ${familySharing.maxAdditionalMembers} 位符合条件的家庭成员共享。`,
      familySharing.sharedBenefits?.[0],
      "成员须与管理员居住在同一国家。",
    ]
      .filter(Boolean)
      .join(" "),
  ]),
) as Record<Need, string>;
const payment = Object.fromEntries(
  data.markets.map(({ code }) => {
    const meta = getCountryMeta(code);
    return [
      code,
      meta
        ? [
            `${giftCardLabels[meta.giftCard]}。官方付款方式包括 ${paymentMethods(meta)}。${meta.notes ? ` ${meta.notes}` : ""}`,
            meta.sources[0],
          ]
        : ["付款方式尚未确认。", "https://support.apple.com/en-us/111741"],
    ];
  }),
) as Record<string, [string, string]>;
const extras = {
  observedAt: pricesObservedAt,
  fxDate,
  payment,
  familyHints,
  cancel:
    "在购买时使用的 Apple 账户中，进入「设置 → 姓名 → 订阅」查看续费日期和取消选项。",
};
---

<Layout
  title="Google One / Gemini 跨区订阅决策器"
  description={`比较 ${data.markets.length} 个 App Store 地区的 Google One、Gemini 订阅总成本。按使用时长、首期资格、家庭人数与付款条件查看方案、账单和当地续费。`}
  dataset
>
  <div class="page-heading"><h1>Google One / Gemini 跨区订阅决策器</h1></div>
  <Decision client:load packed={JSON.stringify(data)} {extras} />
</Layout>
