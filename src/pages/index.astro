---
import { getCountries, getMetadata } from "../lib/data";
import "../styles/global.css";

const { refreshedAt, usdToCny } = getMetadata();
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Google One / Gemini iOS 价格</title>
  </head>
  <body>
    <main>
      <h1>Google One / Gemini iOS 价格</h1>
      <p>覆盖 {getCountries().length} 个国家和地区。</p>
      <p>
        数据刷新于
        <time datetime={refreshedAt}>{refreshedAt.replace("T", " ")}</time>
      </p>
      <p>1 USD = {usdToCny} CNY</p>
    </main>
  </body>
</html>
