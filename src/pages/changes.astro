---
import ChangeGroups from "../components/ChangeGroups.astro";
import Layout from "../components/Layout.astro";
import {
  getChanges,
  getCountries,
  getMetadata,
  summarizeChanges,
} from "../lib/data";
import { formatShanghaiTime } from "../lib/format";

const changes = getChanges();
const summary = summarizeChanges(changes);
const countries = new Map(
  getCountries().map((country) => [country.code, country]),
);
const kinds = [...new Set(changes.map(({ kind }) => kind))];
const filters = kinds.length > 1 ? ["全部", ...kinds] : kinds;
const time = getMetadata().changesCheckedAt;
const title = "订阅价格变动记录";
const description = `截至 ${formatShanghaiTime(time)}，记录 ${summary.countries} 个国家/地区的 ${summary.count} 条 App Store 订阅变动，含 ${summary.trials} 条免费试用和 ${summary.offers} 条首期优惠。`;
---

<Layout {title} {description}>
  <div class="page-heading"><h1>变动记录</h1></div>
  <dl class="change-summary">
    <div>
      <dt>最近检查（北京时间）</dt>
      <dd>
        <time datetime={`${time}+08:00`}>{formatShanghaiTime(time)}</time>
      </dd>
    </div>
    <div>
      <dt>变动</dt>
      <dd><span class="mono">{summary.count}</span> 条</dd>
    </div>
    <div>
      <dt>涉及地区</dt>
      <dd><span class="mono">{summary.countries}</span> 个</dd>
    </div>
    <div>
      <dt>免费试用／首期优惠</dt>
      <dd class="mono">{summary.trials} / {summary.offers}</dd>
    </div>
  </dl>
  {kinds.length > 1 && (
    <fieldset class="pills change-filters" aria-label="变动类型">
      {filters.map((kind, index) => (
        <label class="control">
          <input
            class="sr-only"
            type="radio"
            name="change-kind"
            data-change-kind
            value={kind}
            checked={index === 0}
          />
          {kind === "新发现地区SKU" ? "新发现地区 SKU" : kind}
        </label>
      ))}
    </fieldset>
  )}
  {filters.map((kind, index) => (
    <div data-kind-panel={kind} hidden={index !== 0}>
      <ChangeGroups
        changes={
          kind === "全部"
            ? changes
            : changes.filter((change) => change.kind === kind)
        }
        {countries}
        linkable={index === 0}
      />
    </div>
  ))}
  {filters.length === 0 && <p class="empty-message">本次检查没有变动记录。</p>}
</Layout>
<style>
.change-summary {
  display: grid;
  grid-template-columns: 1.5fr 1fr 1fr 1.2fr;
  background: var(--bg-subtle);
  border: 1px solid var(--border-default);
  border-radius: 4px;
}
.change-summary > div {
  padding: 8px 12px;
}
.change-summary > div + div {
  border-left: 1px solid var(--border-default);
}
.change-summary dt {
  color: var(--text-secondary);
}
.change-summary dd {
  font-weight: 600;
  margin-top: 2px;
}
.change-filters {
  margin-block: 12px 8px;
}
.change-summary + [data-kind-panel] {
  margin-top: 12px;
}
.change-filters .control:has(:focus-visible) {
  outline: 2px solid var(--text-primary);
  outline-offset: 2px;
}
@media (max-width: 767px) {
  .change-summary {
    grid-template-columns: 1fr 1fr;
  }
  .change-summary > div:nth-child(odd) {
    border-left: 0;
  }
  .change-summary > div:nth-child(n + 3) {
    border-top: 1px solid var(--border-default);
  }
}
</style>
