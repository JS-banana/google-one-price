---
import Layout from "../components/Layout.astro";
import SearchInput from "../components/SearchInput.astro";
import {
  getCountries,
  getExchangeRates,
  getMetadata,
  getTierRanking,
} from "../lib/data";
import { formatRate, formatShanghaiTime } from "../lib/format";

const rates = getExchangeRates();
const countries = getCountries();
const proMarkets = getTierRanking("ai-pro-promo-yearly").length;
const plusMarkets = getTierRanking("ai-plus-promo-yearly").length;
const { usdToCny, fxProvider, fxPublishedAt, refreshedAt } = getMetadata();
const title = "汇率与价格说明";
const description = `查看 ${rates.length} 种币种的人民币折算，当前 1 USD = ${formatRate(usdToCny)} CNY。了解 Google One 与 Gemini iOS 首期、首年月均、续费及 USD 计价区的口径。`;
---

<Layout {title} {description}>
  <div class="page-heading"><h1>汇率与说明</h1></div>
  <section aria-labelledby="calculation">
    <h2 class="section-heading" id="calculation">价格口径</h2>
    <dl class="method-list">
      <div>
        <dt>报价来源与更新</dt>
        <dd>
          数据来自 iOS App Store
          商品目录监控，按小时检查。当前报价快照为北京时间{" "}
          <time datetime={`${refreshedAt}+08:00`}
            >{formatShanghaiTime(refreshedAt)}</time
          >。
        </dd>
      </div>
      <div>
        <dt>人民币换算</dt>
        <dd>
          原币金额 × USD/CNY ÷ 1 USD
          兑换的原币数量。显示金额保留两位小数，排名使用舍入前的价格。
        </dd>
      </div>
      <div>
        <dt>首期月价</dt>
        <dd>
          优惠期间每月的人民币价格。无优惠时取续费原价，免费试用按 SKU
          编码显示时长。
        </dd>
      </div>
      <div>
        <dt>首年月均</dt>
        <dd>
          首年付款总额 ÷ 12。月付的付费优惠按说明里的期数计算，免费试用按 SKU
          编码扣除试用月数。年付试用结束时计入一次完整年费，年付首年折扣取折后年费。
        </dd>
      </div>
      <div>
        <dt>档位覆盖范围</dt>
        <dd>
          首页榜单和矩阵比较 20x 大容量、Google AI Pro、Google AI Plus 及 20
          TB、10 TB 存储的精选档位。AI Pro 和 AI Plus 的年付首年 7.5 折分别覆盖
          {proMarkets} 和 {plusMarkets} 个市场。年付优惠档位按至少 10
          个活跃市场的覆盖范围选入。免费试用在首页单独汇总，完整报价见国家页。
        </dd>
      </div>
      <div>
        <dt>续费月价</dt>
        <dd>
          优惠结束后每月折合的人民币价格。原币副价保留 App Store 的实际账期。
        </dd>
      </div>
      <div>
        <dt>活跃／历史快照</dt>
        <dd>
          活跃报价来自当前目录或监控结果，参与排名。历史快照保留当时的币种和报价，可在国家页面展开。
        </dd>
      </div>
      <div>
        <dt>USD 计价区</dt>
        <dd>
          美国以外使用 USD 标价的 App Store 地区。档位排名和矩阵可筛掉这些地区。
        </dd>
      </div>
      <div>
        <dt>续费跳涨</dt>
        <dd>
          跳涨倍数 = 续费原币价 ÷
          首期原币价。零元试用直接展示试用结束后的月均续费价。
        </dd>
      </div>
    </dl>
  </section>
  <section class="rates-section" aria-labelledby="fx">
    <div class="section-heading rates-heading">
      <div>
        <h2 id="fx">汇率表</h2>
        <p class="secondary">
          基准
          <strong class="mono">1 USD = {formatRate(usdToCny)} CNY</strong> ·
          {fxProvider} 发布于
          <time datetime={fxPublishedAt}
            >{formatShanghaiTime(fxPublishedAt)}</time
          >（北京时间）
        </p>
      </div>
      <SearchInput
        id="rate-q"
        label="筛选币种或地区"
        placeholder="搜索币种或地区"
        target="rate-list"
      />
    </div>
    <div class="panel" id="rate-list">
      <table class="data-table rate-table">
        <thead>
          <tr>
            <th scope="col">币种</th>
            <th scope="col">中文名</th>
            <th scope="col" class="num">1 USD 兑本币</th>
            <th scope="col" class="num">1 本币折 CNY</th>
            <th scope="col">地区</th>
          </tr>
        </thead>
        <tbody>
          {rates.map(({ currency, nameZh, unitsPerUsd }) => {
            const locales = countries.filter(
              (country) => country.currency === currency,
            );
            const links = locales.map(({ code, nameZh }) => (
              <a href={`/countries/${code.toLowerCase()}`}>{nameZh}</a>
            ));
            const first =
              locales.find(({ code }) => code === "USA") ?? locales[0];
            return (
              <tr
                data-match={`${currency} ${nameZh} ${locales.map(({ code, nameZh, nameEn }) => `${code} ${nameZh} ${nameEn}`).join(" ")}`}
              >
                <th scope="row" class="mono rate-currency">
                  {currency}
                  <span class="rate-mobile-name">{nameZh}</span>
                </th>
                <td class="rate-name">{nameZh}</td>
                <td class="num">{formatRate(unitsPerUsd)}</td>
                <td class="num">{formatRate(usdToCny / unitsPerUsd)}</td>
                <td class="rate-locales">
                  {locales.length === 0 ? (
                    <span class="muted">·</span>
                  ) : locales.length <= 4 ? (
                    links
                  ) : (
                    <>
                      <span class="rate-all-locales">{links}</span>
                      <details class="rate-more-locales">
                        <summary>
                          {first.nameZh} 等 {locales.length} 个地区
                        </summary>
                        <div>{links}</div>
                      </details>
                    </>
                  )}
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
      <p class="empty-message" data-filter-empty hidden>
        找不到符合条件的币种。
      </p>
    </div>
  </section>
  <section class="rates-section" aria-labelledby="faq">
    <h2 class="section-heading" id="faq">常见问题</h2>
    <dl class="method-list">
      <div>
        <dt>为什么同一地区有多个相近的 SKU？</dt>
        <dd>
          同一套餐可能通过多个商品编号上架。每个档位按当前口径为每个地区选一条最低活跃报价，国家详情保留各
          SKU。
        </dd>
      </div>
      <div>
        <dt>最低价能直接购买吗？</dt>
        <dd>
          订阅和优惠资格由你的 App Store
          地区、账户及商品条款决定。请在确认付款前核对实际金额、续费日期和税费。
        </dd>
      </div>
    </dl>
  </section>
  <section class="rates-section disclaimer" aria-labelledby="terms">
    <h2 class="section-heading" id="terms">免责声明</h2>
    <p>
      本站是独立的价格查询工具，与 Google 和 Apple
      无隶属、合作或授权关系。数据为监控时点的 App Store
      报价及汇率折算，仅供参考。实际可购买的档位、优惠资格、税费、汇率与扣款金额以你的
      App Store 付款确认页及付款机构为准。
    </p>
    <p id="data-license">
      数据使用：原始商品信息及商标归各权利人所有，使用须遵循各来源条款。本站的整理及人民币换算供查询参考。
    </p>
  </section>
</Layout>
<style>
.method-list {
  background: var(--bg-surface);
  border: 1px solid var(--border-default);
  border-radius: 4px;
}
.method-list > div {
  display: grid;
  grid-template-columns: minmax(125px, 1fr) 6fr;
  gap: 8px 16px;
  padding: 8px 12px;
}
.method-list > div + div {
  border-top: 1px solid var(--border-default);
}
.method-list dt {
  font-weight: 600;
}
.method-list dd,
.disclaimer p {
  color: var(--text-secondary);
  font-size: 14px;
  line-height: 22px;
}
.rates-section {
  margin-top: 22px;
}
.rates-heading {
  flex-wrap: wrap;
  align-items: flex-end;
  justify-content: space-between;
}
.rates-heading h2 {
  margin-bottom: 3px;
}
.rate-currency {
  text-align: left;
  white-space: nowrap;
}
.rate-mobile-name {
  display: none;
}
.rate-table th:first-child,
.rate-table td.num,
.rate-table th.num {
  white-space: nowrap;
}
.rate-table tr:hover td,
.rate-table tr:hover th[scope="row"] {
  background: var(--bg-hover);
}
.rate-locales a {
  display: inline-flex;
  align-items: center;
  min-width: 24px;
  min-height: 24px;
  margin-right: 8px;
}
.rate-more-locales {
  display: none;
}
.disclaimer p + p {
  margin-top: 6px;
}
@media (max-width: 767px) {
  .method-list > div {
    grid-template-columns: minmax(0, 1fr);
    gap: 2px;
  }
  .rate-table th,
  .rate-table td {
    padding-inline: 5px;
  }
  .rate-name,
  .rate-table :where(thead) th:where(:nth-child(2)) {
    display: none;
  }
  .rate-mobile-name {
    display: block;
    color: var(--text-secondary);
    font: 11px / 15px var(--font-ui);
  }
  .rate-all-locales {
    display: none;
  }
  .rate-more-locales {
    display: block;
  }
  .rate-more-locales summary {
    cursor: pointer;
  }
  .rate-table td,
  .rate-table th {
    font-size: 11px;
  }
}
</style>
