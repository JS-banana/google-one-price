---
import { type CollectionEntry, getCollection, render } from "astro:content";
import Layout from "../../components/Layout.astro";

export async function getStaticPaths() {
  return (await getCollection("guide")).map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}
const { entry } = Astro.props as { entry: CollectionEntry<"guide"> };
const { Content } = await render(entry);
const { title, summary, reviewedAt, sources } = entry.data;
---

<Layout
  {title}
  description={summary}
  article={{ reviewedAt, sources }}
  crumbs={[
    { name: "方案推荐", href: "/" },
    { name: "避坑指南", href: "/guide" },
    { name: title, href: `/guide/${entry.id}` },
  ]}
>
  <article class="guide-article">
    <header class="page-heading">
      <div>
        <p class="breadcrumb"><a href="/guide">避坑指南</a></p>
        <h1>{title}</h1>
        <p class="secondary">{summary}</p>
        <p class="small muted">
          复核 <time datetime={reviewedAt}>{reviewedAt}</time>
        </p>
      </div>
    </header>
    <div class="guide-prose"><Content /></div>
    <section aria-labelledby="article-sources">
      <h2 class="section-heading" id="article-sources">官方来源</h2>
      <ul class="panel sources">
        {sources.map((url) => {
          const { hostname, pathname } = new URL(url);
          return (
            <li>
              <a href={url}>
                {hostname}
                {pathname}
              </a>
            </li>
          );
        })}
      </ul>
    </section>
    <p class="guide-return"><a href="/">按我的条件比较订阅方案 →</a></p>
  </article>
</Layout>
<style>
.guide-article {
  max-width: 760px;
}
.guide-article header p {
  margin-top: 4px;
}
.guide-prose {
  font-size: 14px;
  line-height: 1.65;
  margin-bottom: 24px;
}
.guide-prose :global(h2) {
  border-top: 2px solid var(--text-primary);
  margin-top: 16px;
  padding-top: 8px;
}
.guide-prose :global(p),
.guide-prose :global(ul),
.guide-prose :global(ol) {
  margin-top: 8px;
}
.guide-prose :global(ul),
.sources {
  list-style: disc;
  padding-left: 26px;
}
.guide-prose :global(ol) {
  padding-left: 26px;
  list-style: decimal;
}
.guide-prose :global(li + li),
.sources li + li {
  margin-top: 4px;
}
.sources {
  padding-block: 10px;
  padding-right: 10px;
  overflow-wrap: anywhere;
}
.guide-return {
  margin-top: 14px;
}
</style>
