{
  "name": "google-one-price",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=22.23.4 <23"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "deploy": "astro build && wrangler deploy",
    "cf:dry": "wrangler deploy --dry-run",
    "check": "astro check && tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "test": "vitest run",
    "data:import": "node scripts/data.ts import",
    "data:check": "node scripts/data.ts check"
  },
  "dependencies": {
    "@astrojs/preact": "6.1.6",
    "@astrojs/sitemap": "3.7.6",
    "astro": "7.4.13",
    "decimal.js": "10.6.0",
    "preact": "11.2.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@biomejs/biome": "2.6.9",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "22.20.7",
    "lefthook": "2.2.4",
    "read-excel-file": "9.3.20",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vitest": "5.1.2",
    "wrangler": "4.168.0"
  }
}
